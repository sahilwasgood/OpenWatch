// Workbench: the only surface that renders raw frames and hex. Every row comes
// from the local store; nothing here is decoded into a Today/Device reading.
import { Theme } from "theme.slint";

export struct FrameView {
    id: int,
    time: string,
    direction: string,
    cmd: string,
    opcode: string,
    confidence: string,
    confidence-tag: string,
    hex: string,
}

export struct ActionView {
    key: string,
    title: string,
    tag: string,
    detail: string,
}

component FrameRow inherits Rectangle {
    in property <FrameView> row-data;
    in property <bool> selected: false;
    callback clicked();
    height: 40px;
    background: root.selected ? Theme.accent : (row-touch.has-hover ? Theme.glass-card-dark : transparent);
    border-radius: Theme.radius-sm;

    // A selected row is an accent fill, so every cell flips to near-black.
    Text {
        x: 8px; y: 12px; width: 150px;
        text: root.row-data.time;
        color: root.selected ? Theme.zinc-950 : Theme.text-secondary;
        font-size: Theme.font-micro;
        font-family: Theme.numeral-font;
    }
    Text {
        x: 164px; y: 12px; width: 36px;
        text: root.row-data.direction;
        color: root.selected ? Theme.zinc-950 : Theme.text-primary;
        font-size: Theme.font-micro;
    }
    Text {
        x: 206px; y: 12px; width: 52px;
        text: root.row-data.cmd;
        color: root.selected ? Theme.zinc-950 : Theme.text-primary;
        font-size: Theme.font-micro;
        font-family: Theme.numeral-font;
    }
    // Evidence tag: L / S / U. The long label sits in the adjacent column.
    Text {
        x: 264px; y: 12px; width: 20px;
        text: root.row-data.confidence-tag;
        color: root.selected ? Theme.zinc-950 : Theme.text-primary;
        font-size: Theme.font-micro;
        font-weight: 700;
    }
    Text {
        x: 290px; y: 12px; width: 76px;
        text: root.row-data.confidence;
        color: root.selected ? Theme.zinc-950 : Theme.text-secondary;
        font-size: Theme.font-micro;
    }
    Text {
        x: 372px; y: 12px; width: 200px;
        text: root.row-data.opcode;
        color: root.selected ? Theme.zinc-950 : Theme.text-primary;
        font-size: Theme.font-micro;
    }
    Text {
        x: 580px; y: 12px; width: 204px;
        text: root.row-data.hex;
        color: root.selected ? Theme.zinc-950 : Theme.text-secondary;
        font-size: Theme.font-micro;
        font-family: Theme.numeral-font;
    }
    row-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ActionRow inherits Rectangle {
    in property <ActionView> action;
    callback run();
    height: 40px;
    background: run-touch.has-hover ? Theme.glass-card-dark : transparent;
    border-radius: Theme.radius-sm;

    Rectangle {
        x: 6px; y: 10px; width: 20px; height: 20px;
        background: root.action.tag == "S" ? Theme.status-warn : Theme.status-bad;
        border-radius: Theme.radius-sm;
        Text {
            width: 100%; height: 100%;
            text: root.action.tag;
            color: Theme.zinc-950;
            font-size: Theme.font-micro;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 34px; y: 12px; width: parent.width - 104px;
        text: root.action.title;
        color: Theme.text-primary;
        font-size: Theme.font-micro;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - 70px; y: 0; width: 64px; height: 40px;
        background: run-touch.pressed ? Theme.accent : Theme.glass-card-dark;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.card-edge;
        accessible-role: button;
        accessible-label: "Review " + root.action.title;
        Text {
            width: 100%; height: 100%;
            text: "Review";
            color: run-touch.pressed ? Theme.zinc-950 : Theme.text-primary;
            font-size: Theme.font-label;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        run-touch := TouchArea {
            clicked => { root.run(); }
        }
    }
}

export component WorkbenchSurface inherits Rectangle {
    in property <bool> narrow: false;
    in property <[FrameView]> frames: [];
    in property <[ActionView]> actions: [];
    in property <int> selected-frame: -1;
    in property <string> selected-time: "";
    in property <string> selected-direction: "";
    in property <string> selected-cmd: "";
    in property <string> selected-opcode: "";
    in property <string> selected-confidence: "";
    in property <string> selected-hex: "";
    in-out property <string> note: "";
    in-out property <string> endpoint: "";
    in-out property <string> key: "";
    in property <bool> has-key: false;
    in property <string> preview: "";
    in property <string> explanation: "";
    in property <string> status: "";
    in property <string> pending: "";
    in property <string> confirmed: "";

    callback select-frame(int);
    callback key-edited(string);
    callback preview-payload();
    callback explain-frame();
    callback request-action(string);
    callback confirm-action();
    callback cancel-action();

    property <length> panel-gap: Theme.space-4;
    property <length> panel-width: (root.width - panel-gap) / 2;

    // Fixed-height cards inside a Flickable: the wide branch shows the two
    // lower panels side by side, the narrow branch stacks them full width.
    Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: root.narrow ? 712px + panel-gap + 336px + Theme.space-4 : 712px;

        // Frame table: time, direction, command, confidence tag, confidence,
        // opcode name and the exact hex — the only place hex is rendered.
        Rectangle {
            y: 8px; width: 100%; height: 200px;
            background: Theme.content-surface;
            border-radius: Theme.radius-sm;
            Text {
                x: 8px; y: 6px; width: 150px; text: "Time (UTC)";
                color: Theme.text-secondary; font-size: Theme.font-micro;
            }
            Text {
                x: 164px; y: 6px; width: 36px; text: "Dir";
                color: Theme.text-secondary; font-size: Theme.font-micro;
            }
            Text {
                x: 206px; y: 6px; width: 52px; text: "Cmd";
                color: Theme.text-secondary; font-size: Theme.font-micro;
            }
            Text {
                x: 264px; y: 6px; width: 100px; text: "Confidence";
                color: Theme.text-secondary; font-size: Theme.font-micro;
            }
            Text {
                x: 372px; y: 6px; width: 200px; text: "Opcode";
                color: Theme.text-secondary; font-size: Theme.font-micro;
            }
            Text {
                x: 580px; y: 6px; width: 204px; text: "Frame hex";
                color: Theme.text-secondary; font-size: Theme.font-micro;
            }
            Rectangle {
                x: 4px; y: 24px; width: Math.max(parent.width - 8px, 776px); height: 1px;
                background: Theme.card-edge;
            }
            Flickable {
                y: 28px; width: 100%; height: parent.height - 28px;
                content-width: Math.max(self.width, 784px);
                content-height: Math.max(self.height, root.frames.length * 40px);
                for frame[i] in root.frames: FrameRow {
                    y: i * 40px;
                    width: 784px;
                    row-data: frame;
                    selected: root.selected-frame == frame.id;
                    clicked => { root.select-frame(frame.id); }
                }
            }
        }

        // Detail pane for the selected frame.
        Rectangle {
            y: 216px; width: 100%; height: 72px;
            background: Theme.content-surface;
            border-radius: Theme.radius-sm;
            Text {
                x: Theme.space-3; y: 6px; width: parent.width - Theme.space-6;
                text: "Detail · \{root.selected-time} · \{root.selected-direction} · \{root.selected-cmd} · \{root.selected-opcode} [\{root.selected-confidence}]";
                color: Theme.text-primary;
                font-size: Theme.font-body;
                overflow: elide;
            }
            Text {
                x: Theme.space-3; y: 34px; width: parent.width - Theme.space-6;
                text: "Frame \{root.selected-hex}";
                color: Theme.text-secondary;
                font-size: Theme.font-micro;
                font-family: Theme.numeral-font;
                wrap: word-wrap;
            }
        }

        // Advanced actions are tagged S (source) or U (unverified) and never run
        // on a single click: a second, explicit confirmation is required.
        Rectangle {
            x: 0;
            y: root.narrow ? 712px + panel-gap : 296px;
            width: root.narrow ? parent.width : panel-width;
            height: 336px;
            background: Theme.content-surface;
            border-radius: Theme.radius-sm;
            Text {
                x: Theme.space-3; y: 8px; width: parent.width - Theme.space-6;
                text: "Advanced actions · S source / U unverified · preview only";
                color: Theme.text-primary;
                font-size: Theme.font-body;
                overflow: elide;
            }
            Flickable {
                y: 34px; x: 4px; width: parent.width - 8px; height: 180px;
                content-width: self.width;
                content-height: Math.max(self.height, root.actions.length * 40px);
                for action[i] in root.actions: ActionRow {
                    y: i * 40px;
                    width: 100%;
                    action: action;
                    run => { root.request-action(action.key); }
                }
            }
            Rectangle {
                x: 4px; y: 218px; width: parent.width - 8px; height: 1px;
                background: Theme.card-edge;
            }
            Text {
                x: Theme.space-3; y: 226px; width: parent.width - Theme.space-6;
                text: root.pending != "" ? "Review \{root.pending} (preview only)?" : "No action pending";
                color: root.pending != "" ? Theme.status-warn : Theme.text-secondary;
                font-size: Theme.font-label;
                wrap: word-wrap;
            }
            Rectangle {
                x: Theme.space-3; y: 262px; width: 108px; height: 40px;
                visible: root.pending != "";
                background: confirm-touch.pressed ? Theme.accent : Theme.glass-card-dark;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.card-edge;
                accessible-role: button;
                accessible-label: "Mark reviewed";
                Text {
                    width: 100%; height: 100%; text: "Mark reviewed";
                    color: confirm-touch.pressed ? Theme.zinc-950 : Theme.text-primary;
                    font-size: Theme.font-label;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                confirm-touch := TouchArea { clicked => { root.confirm-action(); } }
            }
            Rectangle {
                x: 124px; y: 262px; width: 96px; height: 40px;
                visible: root.pending != "";
                background: cancel-touch.pressed ? Theme.accent : Theme.glass-card-dark;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.card-edge;
                accessible-role: button;
                accessible-label: "Cancel review";
                Text {
                    width: 100%; height: 100%; text: "Cancel";
                    color: cancel-touch.pressed ? Theme.zinc-950 : Theme.text-primary;
                    font-size: Theme.font-label;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                cancel-touch := TouchArea { clicked => { root.cancel-action(); } }
            }
            Text {
                x: Theme.space-3; y: 306px; width: parent.width - Theme.space-6;
                text: "Preview only — no frame is written to the watch.";
                color: Theme.text-secondary; font-size: Theme.font-micro;
            }
        }

        // AI panel. Interpretation is off until a key is entered; the exact body
        // is shown before any send, and the source frame sits beside the answer.
        Rectangle {
            x: root.narrow ? 0 : panel-width + panel-gap;
            y: 216px;
            width: root.narrow ? parent.width : panel-width;
            height: 480px;
            background: Theme.content-surface;
            border-radius: Theme.radius-sm;
            Text {
                x: Theme.space-3; y: 6px; width: parent.width - Theme.space-6;
                text: "AI interpretation · BYOK · \{root.has-key ? "on" : "off"}";
                color: Theme.text-primary;
                font-size: Theme.font-body;
                overflow: elide;
            }
            Text { x: Theme.space-3; y: 28px; text: "Endpoint"; color: Theme.text-secondary; font-size: Theme.font-micro; }
            Rectangle {
                x: Theme.space-3; y: 40px; width: parent.width - Theme.space-6; height: 40px;
                background: Theme.zinc-800;
                border-radius: Theme.radius-sm;
                TextInput {
                    x: Theme.space-2; y: 10px; width: parent.width - Theme.space-3;
                    text <=> root.endpoint;
                    color: Theme.text-primary;
                    font-size: Theme.font-label;
                }
            }
            Text { x: Theme.space-3; y: 88px; text: "API key (memory only, never stored)"; color: Theme.text-secondary; font-size: Theme.font-micro; }
            Rectangle {
                x: Theme.space-3; y: 100px; width: parent.width - Theme.space-6; height: 40px;
                background: Theme.zinc-800;
                border-radius: Theme.radius-sm;
                TextInput {
                    x: Theme.space-2; y: 10px; width: parent.width - Theme.space-3;
                    text <=> root.key;
                    input-type: password;
                    color: Theme.text-primary;
                    font-size: Theme.font-label;
                    edited => { root.key-edited(self.text); }
                }
            }
            Text { x: Theme.space-3; y: 148px; text: "Note"; color: Theme.text-secondary; font-size: Theme.font-micro; }
            Rectangle {
                x: Theme.space-3; y: 160px; width: parent.width - Theme.space-6; height: 40px;
                background: Theme.zinc-800;
                border-radius: Theme.radius-sm;
                TextInput {
                    x: Theme.space-2; y: 10px; width: parent.width - Theme.space-3;
                    text <=> root.note;
                    color: Theme.text-primary;
                    font-size: Theme.font-label;
                }
            }
            Rectangle {
                x: Theme.space-3; y: 212px; width: 120px; height: 40px;
                background: preview-touch.pressed ? Theme.accent : Theme.glass-card-dark;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.card-edge;
                accessible-role: button;
                accessible-label: "Show payload";
                Text {
                    width: 100%; height: 100%; text: "Show payload";
                    color: preview-touch.pressed ? Theme.zinc-950 : Theme.text-primary;
                    font-size: Theme.font-label;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                preview-touch := TouchArea { clicked => { root.preview-payload(); } }
            }
            Rectangle {
                x: 148px; y: 212px; width: 96px; height: 40px;
                background: explain-touch.pressed ? Theme.accent : Theme.glass-card-dark;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.card-edge;
                accessible-role: button;
                accessible-label: "Explain frame";
                Text {
                    width: 100%; height: 100%; text: "Explain";
                    color: explain-touch.pressed ? Theme.zinc-950 : Theme.text-primary;
                    font-size: Theme.font-label;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                explain-touch := TouchArea { clicked => { root.explain-frame(); } }
            }
            Text {
                x: Theme.space-3; y: 258px; width: parent.width - Theme.space-6;
                text: root.status;
                color: root.has-key ? Theme.text-secondary : Theme.status-warn;
                font-size: Theme.font-micro;
                wrap: word-wrap;
            }
            Text {
                x: Theme.space-3; y: 294px;
                text: "Exact payload (review before send)";
                color: Theme.text-secondary; font-size: Theme.font-micro;
            }
            Rectangle {
                x: Theme.space-3; y: 308px; width: parent.width - Theme.space-6; height: 54px;
                background: Theme.zinc-950;
                border-radius: Theme.radius-sm;
                Text {
                    x: Theme.space-2; y: 4px; width: parent.width - Theme.space-3;
                    text: root.preview != "" ? root.preview : "Select a frame, then show the payload.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-micro;
                    wrap: word-wrap;
                }
            }
            Text {
                x: Theme.space-3; y: 368px; width: parent.width - Theme.space-6;
                text: "Source frame: \{root.selected-hex}";
                color: Theme.text-secondary;
                font-size: Theme.font-micro;
                font-family: Theme.numeral-font;
                wrap: word-wrap;
            }
            Text {
                x: Theme.space-3; y: 404px;
                text: "Explanation";
                color: Theme.text-secondary; font-size: Theme.font-micro;
            }
            Text {
                x: Theme.space-3; y: 420px; width: parent.width - Theme.space-6;
                text: root.explanation != "" ? root.explanation : "—";
                color: Theme.text-primary;
                font-size: Theme.font-micro;
                wrap: word-wrap;
            }
        }
    }
}
