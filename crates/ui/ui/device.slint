// Device: identity, firmware, settings, message apps, alarms, goals and
// faces. Every row is human-readable and carries its last-update time.
import { Theme, GlassCard } from "theme.slint";

export struct RowView {
    group: string,
    title: string,
    value: string,
    detail: string,
    updated-at: string,
}

export component DeviceSurface inherits Rectangle {
    in property <[RowView]> rows: [];
    in property <bool> reduced-transparency: false;
    in property <bool> high-contrast: false;

    for row[i] in root.rows: Rectangle {
        accessible-role: list-item;
        accessible-label: "\{row.group} \{row.title}: \{row.value}";
        // Three columns with matching x/width divisors and a 4 px vertical
        // gap: 15 rows make five bands, 4*88px + 84px = 436px, inside the
        // ~560px content area.
        x: Math.mod(i, 3) * (parent.width / 3) + Theme.space-3;
        y: Math.floor(i / 3) * 88px;
        width: parent.width / 3 - Theme.space-6;
        height: 84px;

        GlassCard {
            width: 100%;
            height: 100%;
            card-radius: Theme.radius-sm;
            reduced-transparency: root.reduced-transparency;
            high-contrast: root.high-contrast;
        }
        Text {
            x: Theme.space-3;
            y: Theme.space-2;
            width: parent.width - Theme.space-6;
            text: "\{row.group} · \{row.title}";
            color: Theme.text-secondary;
            font-size: Theme.font-label;
            overflow: elide;
        }
        Text {
            x: Theme.space-3;
            y: 26px;
            width: parent.width - Theme.space-6;
            text: row.value;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            font-family: Theme.numeral-font;
            overflow: elide;
        }
        Text {
            x: Theme.space-3;
            y: 48px;
            width: parent.width - Theme.space-6;
            text: row.detail;
            color: Theme.text-secondary;
            font-size: Theme.font-micro;
            overflow: elide;
        }
        Text {
            x: Theme.space-3;
            y: 68px;
            width: parent.width - Theme.space-6;
            text: "Updated \{row.updated-at}";
            color: Theme.text-secondary;
            font-size: Theme.font-micro;
            font-family: Theme.numeral-font;
        }
    }
}
