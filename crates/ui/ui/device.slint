// Device: identity, firmware, settings, message apps, alarms, goals and
// faces. Every row is human-readable and carries its last-update time.
import { Theme, GlassCard } from "theme.slint";

export struct RowView {
    group: string,
    title: string,
    value: string,
    detail: string,
    updated-at: string,
}

export component DeviceSurface inherits Rectangle {
    in property <bool> narrow: false;
    in property <[RowView]> rows: [];
    in property <bool> reduced-transparency: false;
    in property <bool> high-contrast: false;

    // Three columns on desktop, one at 360dp so each row keeps a readable
    // width and the elided labels never collapse into the next column.
    property <int> columns: root.narrow ? 1 : 3;

    Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: Math.max(
            self.height,
            (root.rows.length + root.columns - 1) / root.columns * 88px + Theme.space-3
        );
        for row[i] in root.rows: Rectangle {
            accessible-role: list-item;
            accessible-label: "\{row.group} \{row.title}: \{row.value}";
            // Columns with matching x/width divisors and a 4px vertical gap.
            x: Math.mod(i, root.columns) * (parent.width / root.columns) + Theme.space-3;
            y: Math.floor(i / root.columns) * 88px;
            width: parent.width / root.columns - Theme.space-6;
            height: 84px;

            GlassCard {
                width: 100%;
                height: 100%;
                card-radius: Theme.radius-sm;
                reduced-transparency: root.reduced-transparency;
                high-contrast: root.high-contrast;
            }
            Text {
                x: Theme.space-3;
                y: Theme.space-2;
                width: parent.width - Theme.space-6;
                text: "\{row.group} · \{row.title}";
                color: Theme.text-secondary;
                font-size: Theme.font-label;
                overflow: elide;
            }
            Text {
                x: Theme.space-3;
                y: 26px;
                width: parent.width - Theme.space-6;
                text: row.value;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                font-family: Theme.numeral-font;
                overflow: elide;
            }
            Text {
                x: Theme.space-3;
                y: 48px;
                width: parent.width - Theme.space-6;
                text: row.detail;
                color: Theme.text-secondary;
                font-size: Theme.font-micro;
                overflow: elide;
            }
            Text {
                x: Theme.space-3;
                y: 68px;
                width: parent.width - Theme.space-6;
                text: "Updated \{row.updated-at}";
                color: Theme.text-secondary;
                font-size: Theme.font-micro;
                font-family: Theme.numeral-font;
            }
        }
    }
}
