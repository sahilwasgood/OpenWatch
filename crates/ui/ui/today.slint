// Today: reorderable, human-readable metric cards. No raw frames live here.
import { Theme, GlassCard } from "theme.slint";

export struct CardView {
    key: string,
    title: string,
    value: string,
    detail: string,
    updated-at: string,
}

export component TodaySurface inherits Rectangle {
    in property <[CardView]> cards: [];
    in property <bool> reduced-transparency: false;
    in property <bool> high-contrast: false;
    callback reorder(string, int);

    for card[i] in root.cards: Rectangle {
        x: Theme.space-6 + Math.mod(i, 2) * (parent.width / 2);
        y: Theme.space-6 + Math.floor(i / 2) * 132px;
        width: parent.width / 2 - Theme.space-3;
        height: 120px;

        GlassCard {
            width: 100%;
            height: 100%;
            card-radius: Theme.radius-md;
            reduced-transparency: root.reduced-transparency;
            high-contrast: root.high-contrast;
        }
        Text {
            x: Theme.space-6;
            y: Theme.space-3;
            text: card.title;
            color: Theme.text-secondary;
            font-size: Theme.font-caption;
        }
        // Figures sit on a near-opaque surface above the glass card.
        Rectangle {
            x: Theme.space-6;
            y: Theme.space-6 + Theme.font-caption;
            width: parent.width - Theme.space-6 * 2 - 64px;
            height: 48px;
            background: Theme.content-surface;
            border-radius: Theme.radius-sm;
            Text {
                x: Theme.space-3;
                y: (parent.height - self.height) / 2;
                text: card.value;
                color: Theme.text-primary;
                font-size: Theme.font-hero;
                font-family: Theme.numeral-font;
            }
        }
        Text {
            x: Theme.space-6;
            y: 90px;
            text: card.detail;
            color: Theme.text-secondary;
            font-size: Theme.font-micro;
        }
        Text {
            x: Theme.space-6;
            y: 104px;
            text: "Updated \{card.updated-at}";
            color: Theme.text-secondary;
            font-size: Theme.font-micro;
            font-family: Theme.numeral-font;
        }
        // Visible control affordance on every card: drag handle plus two
        // explicit reorder steps, wired to AppState::move_card by the host.
        Rectangle {
            x: parent.width - 56px;
            y: Theme.space-3;
            width: 44px;
            height: 24px;
            background: Theme.glass-card-dark;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.card-edge;
            Text {
                width: 100%;
                height: 100%;
                text: "☰ Control";
                color: Theme.text-primary;
                font-size: Theme.font-micro;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle {
            x: parent.width - 56px;
            y: 52px;
            width: 20px;
            height: 24px;
            background: up.pressed ? Theme.accent : Theme.glass-card-dark;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.card-edge;
            Text {
                width: 100%;
                height: 100%;
                text: "↑";
                color: Theme.text-primary;
                font-size: Theme.font-caption;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            up := TouchArea {
                clicked => { root.reorder(card.key, -1); }
            }
        }
        Rectangle {
            x: parent.width - 32px;
            y: 52px;
            width: 20px;
            height: 24px;
            background: down.pressed ? Theme.accent : Theme.glass-card-dark;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.card-edge;
            Text {
                width: 100%;
                height: 100%;
                text: "↓";
                color: Theme.text-primary;
                font-size: Theme.font-caption;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            down := TouchArea {
                clicked => { root.reorder(card.key, 1); }
            }
        }
    }
}
